#include <stdio.h>
#include <stdlib.h>
#include <time.h>

#define N 1000

int main() {
    int A[N];
    int i, x;

    srand(time(NULL));

    // 1. Generate 1000 random numbers
    for (i = 0; i < N; i++) {
        A[i] = rand() % 10000;
    }

    // 2. Choose x randomly from the array
    x = A[rand() % N];

    printf("Number to search: %d\n", x);

    // 3. Linear Search
    int linearComparisons = 0;
    int linearPosition = -1;

    for (i = 0; i < N; i++) {
        linearComparisons++;

        if (A[i] == x) {
            linearPosition = i;
            break;
        }
    }

    printf("\n--- Linear Search ---\n");
    printf("Found at index: %d\n", linearPosition);
    printf("Comparisons: %d\n", linearComparisons);

    // 4. Sort the array using Bubble Sort
    for (i = 0; i < N - 1; i++) {
        for (int j = 0; j < N - i - 1; j++) {
            if (A[j] > A[j + 1]) {
                int temp = A[j];
                A[j] = A[j + 1];
                A[j + 1] = temp;
            }
        }
    }

    // 5. Binary Search
    int left = 0;
    int right = N - 1;
    int mid;
    int binaryPosition = -1;
    int binaryComparisons = 0;

    while (left <= right) {
        mid = left + (right - left) / 2;
        binaryComparisons++;

        if (A[mid] == x) {
            binaryPosition = mid;
            break;
        }
        else if (A[mid] < x) {
            left = mid + 1;
        }
        else {
            right = mid - 1;
        }
    }

    printf("\n--- Binary Search ---\n");
    printf("Found at index: %d\n", binaryPosition);
    printf("Comparisons: %d\n", binaryComparisons);

    return 0;
}
