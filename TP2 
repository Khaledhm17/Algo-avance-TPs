
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

#define N 20

int main() {
    double tab[N];
    double temp;
    int i, j, min;

    int comparisons = 0;
    int swaps = 0;

    clock_t start, end;
    double execution_time;

    // Generate 20 random double values between 0 and 1
    srand(time(NULL));

    for (i = 0; i < N; i++) {
        tab[i] = (double)rand() / RAND_MAX;
    }

    printf("Original array:\n");
    for (i = 0; i < N; i++) {
        printf("%.4f ", tab[i]);
    }

    // Start measuring execution time
    start = clock();

    // Selection Sort
    for (i = 0; i < N - 1; i++) {
        min = i;

        for (j = i + 1; j < N; j++) {
            comparisons++;

            if (tab[j] < tab[min]) {
                min = j;
            }
        }

        if (min != i) {
            temp = tab[i];
            tab[i] = tab[min];
            tab[min] = temp;

            swaps++;
        }
    }

    end = clock();

    execution_time =
        (double)(end - start) / CLOCKS_PER_SEC;

    printf("\n\nSorted array:\n");
    for (i = 0; i < N; i++) {
        printf("%.4f ", tab[i]);
    }

    // Display the three results
    printf("\n\n--- Results ---\n");
    printf("Comparisons = %d\n", comparisons);
    printf("Swaps = %d\n", swaps);
    printf("Execution time = %.9f seconds\n",
           execution_time);

    return 0;
}
